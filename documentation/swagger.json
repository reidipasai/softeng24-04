{
  "openapi": "3.0.0",
  "info": {
    "title": "TollSync - OpenAPI 3.0",
    "description": "Interoperable Data Hub for Highway Networks",
    "contact": {
      "email": "spirosmag@ieee.org"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "version": "0.0.1"
  },
  "externalDocs": {
    "description": "Find out more about TollSync",
    "url": "http://github.com/ntua/softeng24-04/README.md"
  },
  "tags": [
    {
      "name": "admin",
      "description": "Every admin operation"
    },
    {
      "name": "login system",
      "description": "register/login/logout operations"
    },
    {
      "name": "toll/passes analysis",
      "description": "Operations with stations and passes"
    }
  ],
  "components": {
    "schemas": {
      "tollstations": {
        "type": "object",
        "properties": {
          "OpID": { "type": "string" },
          "Operator": { "type": "string" },
          "TollID": { "type": "string" },
          "Name": { "type": "string" },
          "PM": { "type": "string" },
          "Locality": { "type": "string" },
          "Road": { "type": "string" },
          "Lat": { "type": "float" },
          "Long": { "type": "float" },
          "Email": { "type": "string" },
          "Price1": { "type": "float" },
          "Price2": { "type": "float" },
          "Price3": { "type": "float" },
          "Price4": { "type": "float" }
        }
      },
      "TollPass": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "date" },
          "tollID": { "type": "string" },
          "tagRef": { "type": "string" },
          "tagHomeID": { "type": "string" },
          "charge": { "type": "string" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string" },
          "role": { "type": "string" }
        }
      },
      "healthcheck_return": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "dbconnection": { "type": "string" },
          "n_stations": { "type": "integer" },
          "n_tags": { "type": "integer" },
          "n_passes": { "type": "integer" }
        }
      },
      "getstations_return": {
        "type": "object",
        "properties": {
          "total_stations": { "type": "integer" },
          "stations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/tollstations"
            }
          }
        }
      },
      "resetstations_return": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "info": { "type": "string" }
        }
      },
      "addpasses_return": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "info": { "type": "string" }
        }
      },
      "resetpasses_return": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "info": { "type": "string" }
        }
      },
      "register_return": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "info": { "type": "string" }
        }
      },
      "login_return": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "info": { "type": "string" },
          "token": { "type": "string" }
        },
        "required": ["status", "info"]
      },
      "logout_return": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "info": { "type": "string" }
        },
        "required": ["status", "info"]
      },
      "charges_by_return": {
        "type": "object",
        "properties": {
          "tollOpID": { "type": "string" },
          "requestTimestamp": { "type": "string", "format": "date-time" },
          "periodFrom": { "type": "string", "format": "date-time" },
          "periodTo": { "type": "string", "format": "date-time" },
          "vOpList": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "visitingOpID": { "type": "string" },
                "nPasses": { "type": "integer" },
                "passesCost": { "type": "number", "format": "float" }
              },
              "required": ["visitingOpID", "nPasses", "passesCost"]
            }
          }
        },
        "required": [
          "tollOpID",
          "requestTimestamp",
          "periodFrom",
          "periodTo",
          "vOpList"
        ]
      },
      "pass_analysis_return": {
        "type": "object",
        "properties": {
          "stationOpID": { "type": "string" },
          "tagOpID": { "type": "string" },
          "requestTimestamp": { "type": "string", "format": "date-time" },
          "periodFrom": { "type": "string", "format": "date-time" },
          "periodTo": { "type": "string", "format": "date-time" },
          "nPasses": { "type": "integer" },
          "passList": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "passIndex": { "type": "integer" },
                "passID": { "type": "integer" },
                "stationID": { "type": "string" },
                "timestamp": { "type": "string", "format": "date-time" },
                "tagID": { "type": "string" },
                "passCharge": { "type": "number", "format": "float" }
              },
              "required": [
                "passIndex",
                "passID",
                "stationID",
                "timestamp",
                "tagID",
                "passCharge"
              ]
            }
          }
        },
        "required": [
          "stationOpID",
          "tagOpID",
          "requestTimestamp",
          "periodFrom",
          "periodTo",
          "nPasses",
          "passList"
        ]
      },
      "passes_cost_return": {
        "type": "object",
        "properties": {
          "tollOpID": { "type": "string" },
          "tagOpID": { "type": "string" },
          "requestTimestamp": { "type": "string", "format": "date-time" },
          "periodFrom": { "type": "string", "format": "date-time" },
          "periodTo": { "type": "string", "format": "date-time" },
          "nPasses": { "type": "integer" },
          "passesCost": { "type": "number", "format": "float" }
        },
        "required": [
          "tollOpID",
          "tagOpID",
          "requestTimestamp",
          "periodFrom",
          "periodTo",
          "nPasses",
          "passesCost"
        ]
      },
      "tollstation_passes_return": {
        "type": "object",
        "properties": {
          "stationID": { "type": "string" },
          "stationOperator": { "type": "string" },
          "requestTimestamp": { "type": "string", "format": "date-time" },
          "periodFrom": { "type": "string", "format": "date-time" },
          "periodTo": { "type": "string", "format": "date-time" },
          "nPasses": { "type": "integer" },
          "passList": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "passIndex": { "type": "integer" },
                "passID": { "type": "string" },
                "timestamp": { "type": "string", "format": "date-time" },
                "tagID": { "type": "string" },
                "tagProvider": { "type": "string" },
                "passType": { "type": "string" },
                "passCharge": { "type": "number", "format": "float" }
              },
              "required": [
                "passIndex",
                "passID",
                "timestamp",
                "tagID",
                "tagProvider",
                "passType",
                "passCharge"
              ]
            }
          }
        },
        "required": [
          "stationID",
          "stationOperator",
          "requestTimestamp",
          "periodFrom",
          "periodTo",
          "nPasses",
          "passList"
        ]
      }
    }
  },
  "paths": {
    "/api/admin/healthcheck": {
      "get": {
        "tags": ["admin"],
        "summary": "Healthcheck",
        "description": "Performs a healthcheck with the mongodb database. Returns the status of the connection with the database, the total unique number of tollstations, tags, and passes.",
        "operationId": "healthcheck",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "dbconnection": {
                      "type": "string"
                    },
                    "n_stations": {
                      "type": "integer"
                    },
                    "n_tags": {
                      "type": "integer"
                    },
                    "n_passes": {
                      "type": "integer"
                    }
                  }
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "dbconnection": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "admin_auth": ["read:admin"]
          }
        ]
      }
    },
    "/api/admin/getstations": {
      "get": {
        "tags": ["admin"],
        "summary": "Get Toll Stations",
        "description": "Returns a JSON with all the toll stations information.",
        "operationId": "getstations",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total_stations": {
                      "type": "integer"
                    },
                    "stations": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/tollstations"
                      }
                    }
                  }
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "info": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "admin_auth": ["read:admin"]
          }
        ]
      }
    },
