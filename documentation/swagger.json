    "/api/login": {
      "post": {
        "tags": ["login system"],
        "summary": "Login a user",
        "description": "Login a user by accepting JSON or CSV data with username and password.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": ["username", "password"]
              }
            },
            "text/csv": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully logged in",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid data format or columns",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "info": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid credentials or already logged in",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "info": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "info": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/logout": {
      "post": {
        "tags": ["login system"],
        "summary": "Logout a user",
        "description": "Logout a user by invalidating the token.",
        "operationId": "logout",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "description": "The authentication token of the user to log out"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully logged out",
            "content": {}
          },
          "400": {
            "description": "Token missing",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "info": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid or already logged out token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "info": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "info": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/chargesBy/{tollOpID}/{date_from}/{date_to}": {
      "get": {
        "tags": ["toll/passes analysis"],
        "summary": "Get charges by visiting operators",
        "description": "Returns a JSON with data about the passes that happened from users with a different tagOpID than tollOpID.",
        "operationId": "charges_by",
        "parameters": [
          {
            "name": "tollOpID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The toll operator ID"
            }
          },
          {
            "name": "date_from",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{8}$",
              "description": "Starting date of the search in YYYYMMDD format"
            }
          },
          {
            "name": "date_to",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{8}$",
              "description": "Ending date of the search in YYYYMMDD format"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["json", "csv"],
              "default": "json",
              "description": "The desired response format, either 'json' or 'csv'. Defaults to 'json'."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved charges data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tollOpID": {
                      "type": "string",
                      "description": "The toll operator ID"
                    },
                    "requestTimestamp": {
                      "type": "string",
                      "format": "date-time",
                      "description": "The timestamp of the request"
                    },
                    "periodFrom": {
                      "type": "string",
                      "format": "date-time",
                      "description": "The start date of the period"
                    },
                    "periodTo": {
                      "type": "string",
                      "format": "date-time",
                      "description": "The end date of the period"
                    },
                    "vOpList": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "visitingOpID": {
                            "type": "string",
                            "description": "The visiting operator ID"
                          },
                          "nPasses": {
                            "type": "integer",
                            "description": "Number of passes made by the visiting operator"
                          },
                          "passesCost": {
                            "type": "number",
                            "format": "float",
                            "description": "Total cost of the passes made by the visiting operator"
                          }
                        }
                      },
                      "description": "List of visiting operators and their respective pass data"
                    }
                  }
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string",
                  "description": "CSV format output"
                }
              }
            }
          },
          "400": {
            "description": "Bad request due to invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "info": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
